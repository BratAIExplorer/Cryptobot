# PostgreSQL Database (for user management - SEPARATE from bot SQLite)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cryptobot_enterprise

# JWT Authentication
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin User (created on first run)
ADMIN_EMAIL=admin@cryptobot.local
ADMIN_PASSWORD=change_me_immediately

# Bot Database Path (read-only access)
BOT_DB_PATH=../../data/multi/trades_paper.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Environment
ENVIRONMENT=development
