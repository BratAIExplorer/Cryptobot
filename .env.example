# CryptoBots V3 Configuration Template
# Copy this file to .env and fill in your actual values

# =================================
# BINANCE API CREDENTIALS
# =================================

# LIVE Trading (REAL MONEY - Use with caution!)
BINANCE_API_KEY=your_live_api_key_here
BINANCE_API_SECRET=your_live_api_secret_here

# TESTNET Trading (Fake money for testing - RECOMMENDED!)
# Get keys from: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Trading Mode (paper, testnet, or live)
TRADING_MODE=testnet

# Alert Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook

# Health Monitor Settings
HEARTBEAT_INTERVAL=60        # seconds
MAX_HEARTBEAT_MISS=5         # trigger alert after this many missed beats
DATA_LATENCY_THRESHOLD=10    # seconds - warn if data is this old
EMERGENCY_BALANCE_DROP=5     # % - trigger kill switch if balance drops this much in 1 hour

# Backtest Settings
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
INITIAL_BALANCE=10000
TRADING_FEE=0.001            # 0.1% per trade

# Strategy Parameters (Buy @ DIP)
DIP_THRESHOLD=5              # % drop from recent high
LOOKBACK_HOURS=24

# Strategy Parameters (Take Profit)
PROFIT_TARGET=3              # % gain to sell
TRAILING_STOP=1              # % from peak to lock profits
STOP_LOSS=2                  # % loss to exit

# Strategy Parameters (Simple Trend)
FAST_MA=50
SLOW_MA=200
TREND_TIMEFRAME=1h
